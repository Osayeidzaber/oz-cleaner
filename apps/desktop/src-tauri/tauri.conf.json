{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oz Cleaner",
  "version": "0.1.0",
  "identifier": "tech.zaber.ozcleaner",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Oz Cleaner",
        "width": 1360,
        "height": 860,
        "minWidth": 720,
        "minHeight": 500,
        "decorations": false,
        "backgroundColor": "#000000",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": { "../../../target/release/oz-helper.exe": "oz-helper.exe" },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
